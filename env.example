# Set these as Hostinger server-side Environment Variables (NEVER in a frontend .env)
# Supabase > Connect > Session pooler > copy connection string; use URL-encoded password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
APP_URL=https://your-jobdesk-domain.example
PG_POOL_MAX=5
# Hostinger sets PORT automatically. For local development only:
# PORT=3000
